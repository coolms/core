{
    "name": "coolms/core",
    "description": "Kernel contracts for the CoolMS platform: entity vocabulary, persistence-neutral mapping attributes, domain events, config loading, outbox/inbox and the seams modules implement",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "coolms",
        "cms",
        "contracts",
        "domain",
        "hexagonal",
        "outbox"
    ],
    "authors": [
        {
            "name": "Dmitry Popov"
        }
    ],
    "require": {
        "php": "^8.5",
        "symfony/messenger": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/uid": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoolMS\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
